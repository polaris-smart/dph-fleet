{
  "name": "dsh-devices",
  "version": "0.1.0",
  "type": "module",
  "description": "dsh (DeepSeek Harness) 多设备组网插件：mDNS 同网发现、密钥配对、SSH 跨网直连、SFTP 文件传输。装完在 dsh 会话内自动注册 7 个 fleet_* 工具，智能体（agent）直接调用；零 npm 依赖，Node 22 即装即用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "fleet",
    "multi-device",
    "mdns",
    "ssh",
    "sftp",
    "file-transfer"
  ],
  "bin": {
    "fleet7": "dist/mdns/cli.js",
    "fleet8": "dist/ssh/cli.js",
    "fleet-mdns": "dist/mdns/cli.js",
    "fleet-ssh": "dist/ssh/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/",
    "src/",
    "cordis.patch.yml",
    "TROUBLESHOOTING.md",
    "README.md",
    "tsconfig.json",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "smoke": "bash smoke.sh",
    "pack": "npm pack",
    "build": "tsc --noCheck -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "dist/plugin.js",
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
