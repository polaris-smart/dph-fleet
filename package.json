{
  "name": "dph-fleet",
  "version": "0.2.9",
  "type": "module",
  "description": "NoFox Fleet：dph 多设备组网协作插件（mDNS 同网发现+密钥配对 + SSH 跨网直连）。装完 dph 会话内自动注册 4 个 fleet_* 工具，智能体（agent）直接调用；CLI 预编译，Node 22 即装即用。",
  "bin": {
    "fleet7": "bin/fleet7",
    "fleet8": "bin/fleet8",
    "fleet-mdns": "bin/fleet7",
    "fleet-ssh": "bin/fleet8"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "smoke": "bash smoke.sh",
    "pack": "npm pack",
    "build": "tsc --noCheck -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "dist/plugin.js",
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}